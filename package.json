{
  "name": "video-fact-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/content.ts src/page-hook.ts src/background.ts --bundle --outdir=extension/dist --target=chrome111",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write src test extension/manifest.json"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
