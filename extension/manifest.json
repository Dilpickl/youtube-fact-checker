{
  "manifest_version": 3,
  "name": "Video Fact Check",
  "version": "0.2.0",
  "description": "Finds the checkable claims in a YouTube video as you watch.",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["http://127.0.0.1:8787/*"]
}
