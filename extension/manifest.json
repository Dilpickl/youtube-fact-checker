{
  "manifest_version": 3,
  "name": "Video Fact Check",
  "version": "0.8.0",
  "description": "Fact-checks the claims in a YouTube video or Short as you watch, when you ask.",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "dist/background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Fact Check"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["https://video-fact-check-6p2n.onrender.com/*"]
}
